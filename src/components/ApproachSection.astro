---
/**
 * ApproachSection — the distinctive hero-style section pattern.
 *
 * Layout on wide viewports:
 *
 *   | EN headline + paragraph | ZH (vertical, right-to-left columns) |
 *   |        video            |                                      |
 *
 * Chinese text uses `writing-mode: vertical-rl` so characters flow
 * top-to-bottom and new columns flow right-to-left. This mirrors the
 * Class with Nico pattern and reads naturally in classical Chinese
 * typography.
 *
 * On narrow viewports the ZH column flips to horizontal and stacks
 * below the EN block for readability.
 *
 * Slots:
 *   - "en": English text (h2 + paragraph)
 *   - "zh": Chinese text (h2 + paragraph)
 *   - "video": optional video element
 */
interface Props {
  id?: string;
  background?: 'canvas' | 'warm' | 'surface';
  /** Flip orientation so video appears above text. */
  video_position?: 'below' | 'above';
}

const { id, background = 'canvas', video_position = 'below' } = Astro.props;

const bgClass = {
  canvas:   '',
  warm:     'section--warm',
  surface:  'section--surface',
}[background];

const hasVideo = Astro.slots.has('video');
---
<section id={id} class:list={['section', 'approach', bgClass]}>
  <div class="container">
    <div class:list={['approach__grid', hasVideo ? 'has-video' : null]}>
      <div class="approach__en" lang="en-CA">
        <div class:list={['approach__en-text', video_position === 'above' && hasVideo ? 'order-below' : '']}>
          <slot name="en" />
        </div>
        {hasVideo && (
          <div class:list={['approach__video', video_position === 'above' ? 'order-above' : '']}>
            <slot name="video" />
          </div>
        )}
      </div>
      <div class="approach__zh" lang="zh-Hant">
        <slot name="zh" />
      </div>
    </div>
  </div>
</section>

<style>
.approach__grid {
  display: grid;
  gap: var(--space-8);
  grid-template-columns: 1fr;
}

.approach__en > * + * { margin-top: var(--space-6); }

.approach__video {
  width: 100%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-surface);
  box-shadow: var(--shadow-sm);
}
.approach__video :global(video) {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 10;
  object-fit: cover;
}
.order-above { order: -1; }

.approach__zh {
  font-family: var(--font-body);
}

/* On narrow viewports, ZH flows horizontally and stacks below EN. */
@media (max-width: 47.99rem) {
  .approach__zh {
    writing-mode: horizontal-tb;
  }
}

/* Wide viewport: ZH column rotates to vertical-rl mirroring the CWN pattern. */
@media (min-width: 48rem) {
  .approach__grid {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-12);
    align-items: start;
  }
  .approach__zh {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    min-height: 24rem;
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--border-default);
  }
  .approach__zh > :global(* + *) {
    margin-inline-start: var(--space-6);
    margin-top: 0;
  }
  .approach__zh :global(h1),
  .approach__zh :global(h2),
  .approach__zh :global(h3),
  .approach__zh :global(.display) {
    font-family: 'Noto Serif TC', 'Literata', ui-serif, serif;
    font-weight: var(--fw-body-bold);
    line-height: 1.6;
  }
  .approach__zh :global(p) {
    line-height: 1.9;
    letter-spacing: 0.08em;
  }
  .approach__zh :global(.label) {
    line-height: 1.6;
    letter-spacing: 0.12em;
  }
}

/* Very wide: give ZH a little more room. */
@media (min-width: 80rem) {
  .approach__grid {
    gap: var(--space-16);
  }
}

.section--surface { background: var(--bg-surface); }
</style>
