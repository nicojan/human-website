---
/**
 * WordCard — bilingual glossary entry. EN on the left, ZH on the right.
 *
 * Slots:
 *   - "body-en": long-form context for the English entry
 *   - "body-zh": long-form context for the Chinese entry
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  en?: CollectionEntry<'useful_words'>;
  zh?: CollectionEntry<'useful_words'>;
  pair_key: string;
}
const { en, zh, pair_key } = Astro.props;
---
<article class="word-card" id={pair_key}>
  <div class="word-card__grid">
    {en && (
      <div class="word-card__col" lang="en-CA">
        <header class="word-card__header">
          <h3 class="word-card__term">{en.data.term}</h3>
          {en.data.pronunciation && (
            <span class="word-card__pronunciation">{en.data.pronunciation}</span>
          )}
        </header>
        <p class="word-card__definition">{en.data.definition}</p>
        {en.data.example && (
          <blockquote class="word-card__example">{en.data.example}</blockquote>
        )}
        {en.data.etymology && (
          <p class="word-card__etymology"><span class="label">Etymology</span> {en.data.etymology}</p>
        )}
        <div class="word-card__body"><slot name="body-en" /></div>
      </div>
    )}
    {zh && (
      <div class="word-card__col word-card__col--zh" lang="zh-Hant">
        <header class="word-card__header">
          <h3 class="word-card__term">{zh.data.term}</h3>
          {zh.data.pronunciation && (
            <span class="word-card__pronunciation">{zh.data.pronunciation}</span>
          )}
        </header>
        <p class="word-card__definition">{zh.data.definition}</p>
        {zh.data.example && (
          <blockquote class="word-card__example">{zh.data.example}</blockquote>
        )}
        {zh.data.etymology && (
          <p class="word-card__etymology"><span class="label">詞源</span> {zh.data.etymology}</p>
        )}
        <div class="word-card__body"><slot name="body-zh" /></div>
      </div>
    )}
  </div>
</article>

<style>
.word-card {
  padding-block: var(--space-8);
  border-bottom: 1px solid var(--border-default);
}
.word-card:last-child { border-bottom: 0; }

.word-card__grid {
  display: grid;
  gap: var(--space-6);
  grid-template-columns: 1fr;
}
@media (min-width: 48rem) {
  .word-card__grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
  }
}

.word-card__header {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-3);
}
.word-card__term {
  font-family: var(--font-display);
  font-size: var(--fs-h3);
  line-height: var(--lh-h3);
  font-weight: var(--fw-h3);
}
.word-card__col--zh .word-card__term {
  font-family: 'Noto Serif TC', ui-serif, serif;
}
.word-card__pronunciation {
  font-family: var(--font-mono);
  color: var(--text-secondary);
  font-size: var(--fs-caption);
}
.word-card__col--zh .word-card__pronunciation {
  font-family: var(--font-body);
  font-style: italic;
}
.word-card__definition { max-width: 60ch; }
.word-card__example {
  margin-top: var(--space-3);
  padding-inline-start: var(--space-4);
  border-inline-start: 3px solid var(--border-brand);
  color: var(--text-secondary);
  font-style: italic;
}
.word-card__col--zh .word-card__example { font-style: normal; }
.word-card__etymology {
  margin-top: var(--space-3);
  color: var(--text-secondary);
  font-size: var(--fs-caption);
}
.word-card__etymology .label { margin-inline-end: var(--space-2); }
.word-card__body { margin-top: var(--space-3); color: var(--text-secondary); }
.word-card__body:empty { display: none; }
</style>
