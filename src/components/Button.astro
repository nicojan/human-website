---
/**
 * Button — primary CTA component.
 *
 * Renders as <a> when `href` is provided, otherwise as <button>.
 * Three variants: primary (terracotta), secondary (ink), ghost.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className,
  target,
  rel,
  'aria-label': ariaLabel,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
---
<Tag
  href={href}
  type={!href ? type : undefined}
  target={target}
  rel={rel}
  class:list={classes}
  aria-label={ariaLabel}
>
  <slot />
</Tag>

<style>
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-weight: var(--fw-body-bold);
  text-decoration: none;
  border-radius: var(--radius-md);
  border: 2px solid transparent;
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-out),
              color var(--duration-fast) var(--ease-out),
              border-color var(--duration-fast) var(--ease-out),
              transform var(--duration-fast) var(--ease-out);
  min-height: var(--touch-min);
}

.btn:hover { text-decoration: none; }
.btn:active { transform: translateY(1px); }

.btn--md { padding: var(--space-2) var(--space-5); font-size: var(--fs-body); }
.btn--lg { padding: var(--space-3) var(--space-6); font-size: var(--fs-body-lg); }

.btn--primary {
  /* Uses the darker terracotta (4.6:1 with white) so 17px button text
   * clears WCAG AA. Brand terracotta stays for decorative accents only. */
  background: var(--action-primary-accessible);
  color: var(--text-inverse);
  border-color: var(--action-primary-accessible);
}
.btn--primary:hover {
  background: var(--action-primary-hover);
  border-color: var(--action-primary-hover);
  color: var(--text-inverse);
}

.btn--secondary {
  background: var(--action-secondary);
  color: var(--text-inverse);
  border-color: var(--action-secondary);
}
.btn--secondary:hover {
  background: var(--action-secondary-hover);
  border-color: var(--action-secondary-hover);
  color: var(--text-inverse);
}

.btn--ghost {
  background: transparent;
  color: var(--text-primary);
  border-color: var(--border-strong);
}
.btn--ghost:hover {
  background: var(--bg-surface);
  color: var(--text-primary);
}
</style>
