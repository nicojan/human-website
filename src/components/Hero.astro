---
/**
 * Hero — unified hero block with two variants.
 *
 *   variant="bilingual" — homepage. EN headline, subhead, primary CTA
 *     on the left; VerticalChinese on the right (desktop). On mobile the
 *     VerticalChinese is replaced with a horizontal ZH block below the
 *     EN block, separated by a terracotta rule.
 *
 *   variant="mono" — inner page hero. Just title + subhead, no CTA.
 *
 * Copy is always passed in by the caller; the hero is pure layout.
 */
import Button from './Button.astro';
import VerticalChinese from './VerticalChinese.astro';

interface Props {
  variant: 'bilingual' | 'mono';
  /** English headline and sub. */
  en: {
    headline: string;
    sub: string;
  };
  /** Chinese headline and sub (required for variant="bilingual"). */
  zh?: {
    /** Sentence used on mobile AND for screen-reader aria-label. */
    headline: string;
    sub: string;
    /** Optional explicit 3 columns for the desktop VerticalChinese. */
    verticalColumns?: string[];
  };
  /** Primary CTA (bilingual only). */
  cta?: {
    label: string;
    href: string;
  };
}

const { variant, en, zh, cta } = Astro.props;
---
<section class:list={['hero', `hero--${variant}`]}>
  <div class="hero__inner container">
    {variant === 'bilingual' ? (
      <>
        <div class="hero__en" lang="en-CA">
          <h1 class="hero__headline">{en.headline}</h1>
          <p class="hero__sub">{en.sub}</p>
          {cta && (
            <Button href={cta.href} variant="primary" size="lg">
              {cta.label}
            </Button>
          )}
        </div>
        <hr class="hero__rule" aria-hidden="true" />
        <div class="hero__zh">
          <div class="hero__zh-vertical">
            <VerticalChinese
              columns={zh?.verticalColumns}
              ariaLabel={zh?.headline}
            />
          </div>
          <div class="hero__zh-horizontal" lang="zh-Hant" aria-hidden="true">
            <h2 class="hero__zh-headline">{zh?.headline}</h2>
            <p class="hero__zh-sub">{zh?.sub}</p>
          </div>
        </div>
      </>
    ) : (
      <div class="hero__mono" lang="en-CA">
        <h1 class="hero__headline">{en.headline}</h1>
        <p class="hero__sub">{en.sub}</p>
      </div>
    )}
  </div>
</section>

<style>
.hero {
  background: var(--bg-canvas);
  padding-block: var(--space-16) var(--space-20);
}
@media (min-width: 48rem) {
  .hero { padding-block: var(--space-24) var(--space-32); }
}

.hero__inner {
  display: grid;
  gap: var(--space-10);
}

/* ---------- Bilingual ---------- */
.hero--bilingual .hero__inner {
  grid-template-columns: 1fr;
  align-items: center;
}
@media (min-width: 64rem) {
  .hero--bilingual .hero__inner {
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-20);
  }
}

.hero__en {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.hero__headline {
  font-family: var(--font-display);
  font-size: clamp(2.25rem, 1.5rem + 3.5vw, 4.5rem); /* 36 → 72 */
  line-height: 1.02;
  letter-spacing: -0.025em;
  font-weight: var(--fw-display);
  max-width: 18ch;
  text-wrap: balance;
}

.hero__sub {
  font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.25rem); /* 17 → 20 */
  line-height: var(--lh-body-lg);
  color: var(--text-secondary);
  max-width: 40ch;
}

.hero__rule {
  width: 72px;
  height: 2px;
  background: var(--color-terracotta);
  border: 0;
  margin: 0;
}
@media (min-width: 64rem) {
  .hero__rule { display: none; }
}

.hero__zh {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}
.hero__zh-vertical { display: none; }
@media (min-width: 64rem) {
  .hero__zh-vertical { display: block; }
  .hero__zh-horizontal { display: none; }
}

.hero__zh-headline {
  font-family: 'Noto Serif TC', 'Literata', ui-serif, serif;
  font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem); /* 28 → 40 */
  line-height: 1.3;
  letter-spacing: 0;
  font-weight: var(--fw-h2);
  color: var(--text-primary);
  max-width: 18ch;
}
.hero__zh-sub {
  font-family: var(--font-body);
  font-size: var(--fs-body-lg);
  line-height: var(--lh-relaxed, 1.65);
  color: var(--text-secondary);
  max-width: 38ch;
  margin-top: var(--space-3);
}

/* ---------- Mono ---------- */
.hero--mono {
  padding-block: var(--space-16) var(--space-12);
}
@media (min-width: 48rem) {
  .hero--mono { padding-block: var(--space-20) var(--space-16); }
}
.hero__mono {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  max-width: 52rem;
}
.hero--mono .hero__headline {
  font-size: clamp(2rem, 1.4rem + 2.8vw, 3.5rem); /* 32 → 56 */
}
</style>
