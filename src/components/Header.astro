---
/**
 * Header — bilingual masthead.
 *
 * Layout mirrors the Class with Nico pattern adapted for Human: English
 * nav links on the left, the Human wordmark in the centre, Chinese nav
 * links on the right. No language toggle — both languages live on the
 * same URL.
 */
import Wordmark from './Wordmark.astro';
import { NAV_ITEMS, A11Y } from '@i18n/strings';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const normalised = href.replace(/\/$/, '') || '/';
  return current === normalised;
};

const items = NAV_ITEMS;
---
<header class="site-header">
  <div class="site-header__inner container">
    <nav class="site-header__nav site-header__nav--en" aria-label={A11Y.mainNav.en} lang="en-CA">
      <ul role="list" class="site-header__nav-list">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="site-header__nav-link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >{item.en}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="/"
      class="site-header__brand"
      aria-label="Human, an Education Collective / 人本・共學社"
    >
      <Wordmark variant="colour-on-white" height={32} title="" />
    </a>

    <nav class="site-header__nav site-header__nav--zh" aria-label={A11Y.mainNav.zh} lang="zh-Hant">
      <ul role="list" class="site-header__nav-list">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="site-header__nav-link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >{item.zh}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
.site-header {
  background: var(--bg-canvas);
  border-bottom: 1px solid var(--border-default);
  position: sticky;
  top: 0;
  z-index: 10;
}
.site-header__inner {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--space-4);
  min-height: 72px;
  padding-block: var(--space-3);
}
.site-header__brand {
  display: inline-flex;
  align-items: center;
  justify-self: center;
  min-height: var(--touch-min);
}
.site-header__brand:hover { text-decoration: none; }

.site-header__nav-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  padding: 0;
  margin: 0;
  list-style: none;
}
.site-header__nav--en .site-header__nav-list { justify-content: flex-start; }
.site-header__nav--zh .site-header__nav-list { justify-content: flex-end; }

.site-header__nav-link {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-2);
  min-height: var(--touch-min);
  color: var(--text-primary);
  text-decoration: none;
  font-size: var(--fs-label);
  font-weight: var(--fw-body-medium);
  letter-spacing: 0.01em;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
@media (min-width: 64rem) {
  .site-header__nav-link {
    padding-inline: var(--space-3);
    font-size: var(--fs-caption);
  }
}
.site-header__nav--zh .site-header__nav-link {
  font-family: var(--font-body);
}
.site-header__nav-link:hover {
  background: var(--bg-surface);
  text-decoration: none;
}
.site-header__nav-link[aria-current='page'] {
  color: var(--text-primary);
  box-shadow: inset 0 -2px 0 var(--action-primary);
  border-radius: 0;
}

/* On narrow viewports, nav bars collapse under the logo. The logo row
 * comes first, EN nav second, ZH nav third. */
@media (max-width: 47.99rem) {
  .site-header__inner {
    grid-template-columns: 1fr;
    grid-template-areas:
      'brand'
      'nav-en'
      'nav-zh';
    justify-items: center;
    gap: var(--space-2);
  }
  .site-header__brand { grid-area: brand; }
  .site-header__nav--en { grid-area: nav-en; }
  .site-header__nav--zh { grid-area: nav-zh; }
  .site-header__nav--en .site-header__nav-list,
  .site-header__nav--zh .site-header__nav-list {
    justify-content: center;
  }
}
</style>
