---
/**
 * Header — site masthead with wordmark, nav, language switch.
 *
 * On mobile the nav wraps to a second line; on wide viewports it sits
 * inline between the brand and the language switcher. No JS required.
 */
import Wordmark from './Wordmark.astro';
import LangSwitch from './LangSwitch.astro';
import { STRINGS, type Locale } from '@i18n/strings';
import { localeFromPath, localisedUrl } from '@utils/i18n';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = STRINGS[locale];

const navItems = [
  { href: '/',              label: t.nav.home },
  { href: '/about',         label: t.nav.about },
  { href: '/what-we-teach', label: t.nav.teach },
  { href: '/blog',          label: t.nav.blog },
  { href: '/faq',           label: t.nav.faq },
  { href: '/useful-words',  label: t.nav.words },
].map((item) => ({
  ...item,
  href: localisedUrl(item.href, locale),
}));

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const normalised = href.replace(/\/$/, '') || '/';
  return pathname === normalised;
};
---
<header class="site-header">
  <div class="site-header__inner container">
    <a
      href={localisedUrl('/', locale)}
      class="site-header__brand"
      aria-label={`${t.brand.wordmark} ${t.brand.descriptor}`}
    >
      <Wordmark variant="colour-on-white" height={28} title="" />
    </a>

    <nav class="site-header__nav" aria-label={t.a11y.mainNav}>
      <ul role="list" class="site-header__nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="site-header__nav-link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__right">
      <LangSwitch />
    </div>
  </div>
</header>

<style>
.site-header {
  background: var(--bg-canvas);
  border-bottom: 1px solid var(--border-default);
  position: sticky;
  top: 0;
  z-index: 10;
}
.site-header__inner {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  column-gap: var(--space-4);
  row-gap: var(--space-2);
  min-height: 64px;
  padding-block: var(--space-3);
}
.site-header__brand {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  min-height: var(--touch-min);
}
.site-header__brand:hover { text-decoration: none; }
.site-header__right {
  display: flex;
  align-items: center;
  justify-self: end;
}

.site-header__nav-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  padding: 0;
  margin: 0;
  list-style: none;
  justify-content: center;
}

.site-header__nav-link {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-3);
  min-height: var(--touch-min);
  color: var(--text-primary);
  text-decoration: none;
  font-size: var(--fs-caption);
  font-weight: var(--fw-body-medium);
  border-radius: var(--radius-sm);
}
.site-header__nav-link:hover {
  background: var(--bg-surface);
  text-decoration: none;
}
.site-header__nav-link[aria-current='page'] {
  color: var(--text-primary);
  box-shadow: inset 0 -2px 0 var(--action-primary);
  border-radius: 0;
}

/* Narrow viewports: nav drops to its own row below brand/lang switch */
@media (max-width: 47.99rem) {
  .site-header__inner {
    grid-template-columns: auto auto;
    grid-template-areas:
      'brand right'
      'nav   nav';
  }
  .site-header__brand { grid-area: brand; }
  .site-header__right { grid-area: right; }
  .site-header__nav { grid-area: nav; }
  .site-header__nav-list {
    justify-content: flex-start;
    gap: var(--space-1);
  }
}
</style>
