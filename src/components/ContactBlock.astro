---
/**
 * ContactBlock — plain contact channels, bilingual labels.
 *
 * Email + direct social handles. Human, doesn't run its own support
 * accounts yet; links go to Nico's personal socials where he responds
 * about Human, work.
 */
import { CONTACT_HEADING } from '@i18n/strings';

interface Channel {
  label: { en: string; zh: string };
  value: string;
  href?: string;
}

const EMAIL = 'hi@nicojan.com';

const channels: Channel[] = [
  {
    label: { en: 'Email', zh: '電子郵件' },
    value: EMAIL,
    href: `mailto:${EMAIL}`,
  },
  {
    label: { en: 'Instagram', zh: 'Instagram' },
    value: '@nicoxjan',
    href: 'https://instagram.com/nicoxjan',
  },
  {
    label: { en: 'LinkedIn', zh: 'LinkedIn' },
    value: 'Nico Jan',
    href: 'https://www.linkedin.com/in/nicojan/',
  },
  {
    label: { en: 'YouTube', zh: 'YouTube' },
    value: '@nicoxjan',
    href: 'https://www.youtube.com/@nicoxjan',
  },
];
---
<section id="contact" class="section contact">
  <div class="container">
    <div class="contact__heading">
      <h2 lang="en-CA">{CONTACT_HEADING.en}</h2>
      <h2 class="contact__heading--zh" lang="zh-Hant">{CONTACT_HEADING.zh}</h2>
    </div>
    <ul role="list" class="contact__list">
      {channels.map((c) => (
        <li class="contact__row">
          <div class="contact__label">
            <span class="label" lang="en-CA">{c.label.en}</span>
            <span class="label contact__label--zh" lang="zh-Hant">{c.label.zh}</span>
          </div>
          {c.href
            ? <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined}>{c.value}</a>
            : <span>{c.value}</span>
          }
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.contact__heading {
  display: grid;
  gap: var(--space-2);
  grid-template-columns: 1fr;
  margin-bottom: var(--space-8);
}
@media (min-width: 48rem) {
  .contact__heading {
    grid-template-columns: 1fr 1fr;
    align-items: baseline;
  }
  .contact__heading--zh { text-align: end; }
}
.contact__heading h2 {
  font-family: var(--font-display);
  font-size: var(--fs-h2);
  line-height: var(--lh-h2);
  letter-spacing: var(--ls-h2);
  font-weight: var(--fw-h2);
}
.contact__heading--zh {
  font-family: 'Noto Serif TC', ui-serif, serif;
}
.contact__list {
  display: grid;
  gap: var(--space-3);
  padding: 0;
  margin: 0;
  list-style: none;
}
.contact__row {
  display: grid;
  grid-template-columns: minmax(8rem, max-content) 1fr;
  gap: var(--space-4);
  align-items: baseline;
  padding-block: var(--space-3);
  border-bottom: 1px solid var(--border-default);
}
.contact__row:last-child { border-bottom: 0; }
.contact__label {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.contact__label--zh {
  font-family: var(--font-body);
  color: var(--text-secondary);
}
</style>
