---
/**
 * MediaCard — 16:9 video thumbnail with play overlay.
 *
 * v1: the thumbnail is a placeholder gradient (or a real image if passed
 * via `src`). Clicking opens the external video URL in a new tab; a
 * richer modal embed is a post-launch upgrade.
 *
 * Accessibility: the wrapping <a> carries the full descriptive label so
 * the visual caption can stay short.
 */
interface Props {
  /** Optional static thumbnail image. */
  src?: string;
  /** Visible caption below the thumbnail. */
  caption?: string;
  /** Full accessible label for the play action. */
  ariaLabel: string;
  /** Destination — typically a Vimeo or YouTube URL. */
  href?: string;
}

const { src, caption, ariaLabel, href = '#' } = Astro.props;
const isExternal = href.startsWith('http');
---
<figure class="media-card">
  <a
    href={href}
    class="media-card__thumb"
    aria-label={ariaLabel}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
  >
    {src
      ? <img src={src} alt="" loading="lazy" decoding="async" />
      : <span class="media-card__placeholder" aria-hidden="true"></span>
    }
    <span class="media-card__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path d="M8 5.14v13.72L19 12 8 5.14z" />
      </svg>
    </span>
  </a>
  {caption && <figcaption class="media-card__caption">{caption}</figcaption>}
</figure>

<style>
.media-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin: 0;
}

.media-card__thumb {
  position: relative;
  display: block;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-ink);
  transition: transform var(--duration-normal) var(--ease-out);
}
.media-card__thumb:hover { transform: translateY(-2px); text-decoration: none; }

.media-card__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.media-card__placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-sage-deep) 100%);
}

.media-card__play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.media-card__play > svg {
  display: block;
  color: var(--color-white);
  width: 56px;
  height: 56px;
  padding: var(--space-3);
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  transition: background-color var(--duration-fast) var(--ease-out),
              transform var(--duration-fast) var(--ease-out);
}
.media-card__thumb:hover .media-card__play > svg {
  background: var(--color-terracotta);
  transform: scale(1.05);
}

.media-card__caption {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  line-height: var(--lh-caption);
}
</style>
