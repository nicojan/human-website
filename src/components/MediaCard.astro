---
/**
 * MediaCard — 16:9 video embed (or static thumbnail).
 *
 * Two modes, picked by which props arrive:
 *
 *   1. `video` — inline <video> element with AV1 + H.264 sources.
 *      Native browser controls; preload="metadata" so the poster
 *      frame shows without pulling the full clip.
 *
 *   2. `src` — static poster image linking out to an external player.
 *      Kept as a fallback for cases where we don't host the video.
 *
 * When neither is passed, a gradient placeholder renders — the page
 * builds, but nothing plays.
 */
interface VideoSources {
  /** AV1 encode, preferred for modern browsers. */
  av1?: string;
  /** H.264 encode, the broad-compatibility fallback. */
  h264: string;
  /** Optional poster frame to show before play. */
  poster?: string;
}

interface Props {
  /** Inline video sources. When provided, a <video> element is rendered. */
  video?: VideoSources;
  /** Static image URL (used only when `video` is not provided). */
  src?: string;
  /** Visible caption below the media. */
  caption?: string;
  /** Accessible label — used for the <video> aria-label or the <a> label. */
  ariaLabel: string;
  /** External destination when falling back to the static thumbnail. */
  href?: string;
}

const { video, src, caption, ariaLabel, href = '#' } = Astro.props;
const isExternal = href.startsWith('http');
---
<figure class="media-card">
  {video ? (
    <video
      class="media-card__video"
      controls
      preload="metadata"
      playsinline
      poster={video.poster}
      aria-label={ariaLabel}
    >
      {video.av1 && <source src={video.av1} type="video/mp4; codecs=av01.0.08M.08" />}
      <source src={video.h264} type="video/mp4" />
      Your browser does not support embedded video. {ariaLabel}
    </video>
  ) : (
    <a
      href={href}
      class="media-card__thumb"
      aria-label={ariaLabel}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
    >
      {src
        ? <img src={src} alt="" loading="lazy" decoding="async" />
        : <span class="media-card__placeholder" aria-hidden="true"></span>
      }
      <span class="media-card__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
          <path d="M8 5.14v13.72L19 12 8 5.14z" />
        </svg>
      </span>
    </a>
  )}
  {caption && <figcaption class="media-card__caption">{caption}</figcaption>}
</figure>

<style>
.media-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin: 0;
}

.media-card__video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-lg);
  background: var(--color-ink);
  object-fit: cover;
}

.media-card__thumb {
  position: relative;
  display: block;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-ink);
  transition: transform var(--duration-normal) var(--ease-out);
}
.media-card__thumb:hover { transform: translateY(-2px); text-decoration: none; }

.media-card__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.media-card__placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-sage-deep) 100%);
}

.media-card__play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.media-card__play > svg {
  display: block;
  color: var(--color-white);
  width: 56px;
  height: 56px;
  padding: var(--space-3);
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  transition: background-color var(--duration-fast) var(--ease-out),
              transform var(--duration-fast) var(--ease-out);
}
.media-card__thumb:hover .media-card__play > svg {
  background: var(--color-terracotta);
  transform: scale(1.05);
}

.media-card__caption {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  line-height: var(--lh-caption);
}
</style>
