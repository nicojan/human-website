---
/**
 * CTABand — closing call-to-action band on the ink emphasis background.
 *
 *   variant="bilingual" — EN right-aligned on the left, button in the
 *     true centre (achieved with flex-1 on both sides so the button sits
 *     at the viewport midline regardless of text width), ZH left-aligned
 *     on the right. On mobile this collapses to stacked: EN block, ZH
 *     block, full-width button.
 *
 *   variant="mono" — title on the left, button on the right.
 */
import Button from './Button.astro';

interface Props {
  variant: 'bilingual' | 'mono';
  /** English copy. */
  en: { headline: string; sub?: string };
  /** Chinese copy — required for bilingual. */
  zh?: { headline: string; sub?: string };
  /** CTA label and href. */
  cta: { label: string; href: string };
}

const { variant, en, zh, cta } = Astro.props;
---
<section class:list={['cta-band', `cta-band--${variant}`]}>
  <div class="cta-band__inner container">
    {variant === 'bilingual' ? (
      <>
        <div class="cta-band__text cta-band__text--en" lang="en-CA">
          <h2 class="cta-band__headline">{en.headline}</h2>
          {en.sub && <p class="cta-band__sub">{en.sub}</p>}
        </div>
        <div class="cta-band__button">
          <Button href={cta.href} variant="primary" size="lg">{cta.label}</Button>
        </div>
        <div class="cta-band__text cta-band__text--zh" lang="zh-Hant">
          <h2 class="cta-band__headline cta-band__headline--zh">{zh?.headline}</h2>
          {zh?.sub && <p class="cta-band__sub cta-band__sub--zh">{zh.sub}</p>}
        </div>
      </>
    ) : (
      <>
        <div class="cta-band__text cta-band__text--mono" lang="en-CA">
          <h2 class="cta-band__headline">{en.headline}</h2>
          {en.sub && <p class="cta-band__sub">{en.sub}</p>}
        </div>
        <div class="cta-band__button">
          <Button href={cta.href} variant="primary" size="lg">{cta.label}</Button>
        </div>
      </>
    )}
  </div>
</section>

<style>
.cta-band {
  background: var(--bg-emphasis);
  color: var(--text-inverse);
  padding-block: var(--space-16);
}
@media (min-width: 48rem) {
  .cta-band { padding-block: var(--space-20); }
}

.cta-band__inner {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
  align-items: stretch;
}
@media (min-width: 64rem) {
  .cta-band--bilingual .cta-band__inner {
    flex-direction: row;
    align-items: center;
    gap: var(--space-12);
  }
  .cta-band--mono .cta-band__inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-10);
  }
}

.cta-band__text { display: flex; flex-direction: column; gap: var(--space-3); }
.cta-band__text--en { flex: 1; text-align: left; }
.cta-band__text--zh { flex: 1; text-align: left; }
@media (min-width: 64rem) {
  .cta-band__text--en { text-align: right; align-items: flex-end; }
  .cta-band__text--zh { text-align: left; align-items: flex-start; }
}

.cta-band__headline {
  color: var(--text-inverse);
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem); /* 28 → 40 */
  line-height: 1.15;
  letter-spacing: var(--ls-h1);
  font-weight: var(--fw-h1);
  max-width: 18ch;
}
.cta-band__headline--zh {
  font-family: 'Noto Serif TC', 'Literata', ui-serif, serif;
}

.cta-band__sub {
  color: var(--text-inverse);
  opacity: 0.75;
  font-size: var(--fs-body-lg);
  line-height: var(--lh-body-lg);
  max-width: 36ch;
}
.cta-band__sub--zh {
  font-family: var(--font-body);
  line-height: 1.7;
}

.cta-band__button { display: flex; justify-content: center; }
.cta-band--bilingual .cta-band__button { flex: 0 0 auto; }
</style>
