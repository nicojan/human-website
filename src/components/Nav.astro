---
/**
 * Nav — site masthead with two variants.
 *
 *   variant="bilingual" — homepage only. EN links left, wordmark
 *     centre (absolute-positioned on the viewport, not between link
 *     groups), ZH links right. No language toggle.
 *
 *   variant="mono" — inner pages. Wordmark left, EN nav + language
 *     toggle right. The toggle links to the ZH mirror URL.
 *
 * On narrow viewports both collapse to: wordmark left, hamburger right,
 * drawer menu below. Drawer uses a CSS-only checkbox pattern (no JS) so
 * the static Astro build can ship without islands.
 */
import Wordmark from './Wordmark.astro';
import LanguageToggle from './LanguageToggle.astro';
import { NAV_ITEMS_EN, A11Y } from '@i18n/strings';

interface Props {
  variant: 'bilingual' | 'mono';
  /** Current page path so we can mark aria-current. */
  currentPath?: string;
  /** For variant="mono": which locale the page is in. */
  currentLocale?: 'en' | 'zh-hant';
  /** For variant="mono": href of the mirror page for the toggle. */
  mirrorHref?: string;
}

const {
  variant,
  currentPath,
  currentLocale = 'en',
  mirrorHref = '/',
} = Astro.props;

const items = NAV_ITEMS_EN;
const normalize = (href: string) => href.replace(/\/$/, '') || '/';
const current = normalize(currentPath ?? Astro.url.pathname);
const isCurrent = (href: string) => normalize(href) === current;
---
<header class:list={['nav', `nav--${variant}`]} data-variant={variant}>
  <input type="checkbox" id="nav-menu-toggle" class="nav__menu-toggle" aria-hidden="true" />

  <div class="nav__inner container">
    {variant === 'bilingual' ? (
      <>
        <nav class="nav__links nav__links--left" aria-label={A11Y.mainNav.en} lang="en-CA">
          <ul role="list">
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="nav__link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >{item.en}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/" class="nav__brand nav__brand--centre" aria-label="Human, — home">
          <Wordmark variant="colour-on-white" height={32} title="" />
        </a>
        <nav class="nav__links nav__links--right" aria-label={A11Y.mainNav.zh} lang="zh-Hant">
          <ul role="list">
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="nav__link nav__link--zh"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >{item.zh}</a>
              </li>
            ))}
          </ul>
        </nav>
      </>
    ) : (
      <>
        <a href="/" class="nav__brand nav__brand--start" aria-label="Human, — home">
          <Wordmark variant="colour-on-white" height={32} title="" />
        </a>
        <nav class="nav__links nav__links--end" aria-label={A11Y.mainNav.en} lang="en-CA">
          <ul role="list">
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="nav__link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >{item.en}</a>
              </li>
            ))}
          </ul>
          <LanguageToggle current={currentLocale} otherHref={mirrorHref} />
        </nav>
      </>
    )}

    <label for="nav-menu-toggle" class="nav__burger" aria-label={A11Y.openMenu.en}>
      <span class="nav__burger-bar"></span>
      <span class="nav__burger-bar"></span>
      <span class="nav__burger-bar"></span>
    </label>
  </div>

  <div class="nav__drawer" role="dialog" aria-label={A11Y.mainNav.en}>
    <nav class="nav__drawer-nav" lang="en-CA">
      <ul role="list">
        {items.map((item) => (
          <li>
            <a href={item.href} class="nav__drawer-link">{item.en}</a>
          </li>
        ))}
      </ul>
    </nav>
    {variant === 'mono' && (
      <div class="nav__drawer-toggle">
        <LanguageToggle current={currentLocale} otherHref={mirrorHref} />
      </div>
    )}
  </div>
</header>

<style>
.nav {
  background: var(--bg-canvas);
  border-bottom: 1px solid var(--border-default);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav__menu-toggle {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.nav__inner {
  display: grid;
  align-items: center;
  min-height: 72px;
  padding-block: var(--space-3);
  gap: var(--space-4);
}

.nav--bilingual .nav__inner {
  grid-template-columns: 1fr auto 1fr;
}
.nav--mono .nav__inner {
  grid-template-columns: auto 1fr;
}

.nav__links ul {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  list-style: none;
  padding: 0;
  margin: 0;
}
.nav__links--left ul { justify-content: flex-start; }
.nav__links--right ul { justify-content: flex-end; }
.nav__links--end { display: flex; align-items: center; gap: var(--space-4); justify-content: flex-end; }

.nav__link {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-3);
  min-height: var(--touch-min);
  color: var(--text-primary);
  text-decoration: none;
  font-size: var(--fs-caption);
  font-weight: var(--fw-body-medium);
  letter-spacing: 0.01em;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.nav__link--zh { font-family: var(--font-body); }
.nav__link:hover { background: var(--bg-surface); text-decoration: none; }
.nav__link[aria-current='page'] {
  color: var(--text-primary);
  box-shadow: inset 0 -2px 0 var(--color-terracotta);
  border-radius: 0;
}

.nav__brand {
  display: inline-flex;
  align-items: center;
  min-height: var(--touch-min);
  text-decoration: none;
}
.nav__brand:hover { text-decoration: none; }
.nav--bilingual .nav__brand--centre { justify-self: center; }

.nav__burger {
  display: none;
  width: 44px;
  height: 44px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  cursor: pointer;
  border-radius: var(--radius-sm);
}
.nav__burger-bar {
  width: 22px;
  height: 2px;
  background: var(--text-primary);
  border-radius: 1px;
  transition: transform var(--duration-fast) var(--ease-out),
              opacity var(--duration-fast) var(--ease-out);
}

.nav__drawer {
  display: none;
  background: var(--bg-canvas);
  border-top: 1px solid var(--border-default);
  padding-block: var(--space-4) var(--space-6);
}
.nav__drawer-nav ul {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  list-style: none;
  padding: 0;
  margin: 0;
}
.nav__drawer-link {
  display: block;
  padding: var(--space-3) var(--space-4);
  font-size: var(--fs-body-lg);
  font-weight: var(--fw-body-medium);
  color: var(--text-primary);
  text-decoration: none;
  border-radius: var(--radius-sm);
}
.nav__drawer-link:hover {
  background: var(--bg-surface);
  text-decoration: none;
}
.nav__drawer-toggle {
  padding: var(--space-4) var(--space-4) 0;
  border-top: 1px solid var(--border-default);
  margin-top: var(--space-3);
}

@media (max-width: 47.99rem) {
  .nav__links { display: none; }
  .nav__burger { display: inline-flex; justify-self: end; }
  .nav--bilingual .nav__inner,
  .nav--mono .nav__inner {
    grid-template-columns: 1fr auto;
  }
  .nav--bilingual .nav__brand--centre { justify-self: start; }

  .nav__menu-toggle:checked ~ .nav__inner .nav__burger .nav__burger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__menu-toggle:checked ~ .nav__inner .nav__burger .nav__burger-bar:nth-child(2) {
    opacity: 0;
  }
  .nav__menu-toggle:checked ~ .nav__inner .nav__burger .nav__burger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .nav__menu-toggle:checked ~ .nav__drawer { display: block; }
}
</style>
