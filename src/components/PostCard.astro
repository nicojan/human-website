---
/**
 * PostCard — blog post preview card.
 * Consumed by the blog index page and any "related posts" listings.
 */
import type { CollectionEntry } from 'astro:content';
import { localeFromPath, localisedUrl } from '@utils/i18n';
import { STRINGS } from '@i18n/strings';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = STRINGS[locale];

const href = localisedUrl(`/blog/${post.data.pair_key}`, locale);

const dateFormatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-Hant' : 'en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<article class="post-card">
  <a class="post-card__link" href={href}>
    <h3 class="post-card__title">{post.data.title}</h3>
  </a>
  <p class="post-card__summary">{post.data.summary}</p>
  <div class="post-card__meta">
    <span class="label">{post.data.author}</span>
    <span class="small">·</span>
    <time datetime={post.data.date.toISOString()} class="small">
      {dateFormatter.format(post.data.date)}
    </time>
  </div>
</article>

<style>
.post-card {
  padding-block: var(--space-6);
  border-bottom: 1px solid var(--border-default);
}
.post-card:last-child { border-bottom: 0; }

.post-card__link {
  display: block;
  text-decoration: none;
  color: inherit;
}
.post-card__link:hover .post-card__title { color: var(--text-brand); }

.post-card__title {
  font-family: var(--font-display);
  font-size: var(--fs-h3);
  line-height: var(--lh-h3);
  font-weight: var(--fw-h3);
  margin-bottom: var(--space-2);
  transition: color var(--duration-fast) var(--ease-out);
}
.post-card__summary {
  color: var(--text-secondary);
  margin-bottom: var(--space-2);
  max-width: 60ch;
}
.post-card__meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--text-secondary);
}
</style>
