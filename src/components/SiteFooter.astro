---
/**
 * SiteFooter — page footer with two variants.
 *
 *   variant="bilingual" — 4 columns with bilingual column headers and
 *     links. Used on the home page where both languages co-exist.
 *
 *   variant="mono" — 3 columns, EN only. The Chinese lines below the
 *     brand lockup (人本・共學社 and 溫哥華・卑詩省) are dropped.
 *
 * Copy comes from @i18n/strings; only the variant and (for mono) the
 * locale need to be passed in.
 */
import Wordmark from './Wordmark.astro';
import {
  FOOTER_SITE_LINKS,
  FOOTER_CONTACT_LINKS,
  FOOTER_COL_HEADERS,
  FOOTER_LOCATION,
  FOOTER_TAGLINE_BOTTOM,
  BRAND_FULL_ZH,
  BRAND_DESCRIPTOR_EN,
  A11Y,
} from '@i18n/strings';

interface Props {
  variant: 'bilingual' | 'mono';
}

const { variant } = Astro.props;
const bilingual = variant === 'bilingual';
const year = new Date().getFullYear();
---
<footer class:list={['footer', `footer--${variant}`]}>
  <div class="footer__inner container">
    <div class="footer__brand">
      <Wordmark variant="mono-bark" height={28} title="Human,"/>
      {bilingual && (
        <p class="footer__brand-zh" lang="zh-Hant">{BRAND_FULL_ZH}</p>
      )}
      <p class="footer__brand-en" lang="en-CA">{BRAND_DESCRIPTOR_EN}</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__col-title">
        <span lang="en-CA">{FOOTER_COL_HEADERS.site.en}</span>
        {bilingual && (
          <>
            <span class="footer__dot" aria-hidden="true">·</span>
            <span lang="zh-Hant">{FOOTER_COL_HEADERS.site.zh}</span>
          </>
        )}
      </h2>
      <ul role="list" class="footer__links" aria-label={A11Y.footerLinks.en}>
        {FOOTER_SITE_LINKS.map((link) => (
          <li>
            <a href={link.href} class="footer__link">
              <span lang="en-CA">{link.en}</span>
              {bilingual && (
                <>
                  <span class="footer__dot" aria-hidden="true">·</span>
                  <span lang="zh-Hant">{link.zh}</span>
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__col-title">
        <span lang="en-CA">{FOOTER_COL_HEADERS.contact.en}</span>
        {bilingual && (
          <>
            <span class="footer__dot" aria-hidden="true">·</span>
            <span lang="zh-Hant">{FOOTER_COL_HEADERS.contact.zh}</span>
          </>
        )}
      </h2>
      <ul role="list" class="footer__links">
        {FOOTER_CONTACT_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="footer__link"
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >{link.en}</a>
          </li>
        ))}
      </ul>
    </div>

    {bilingual && (
      <div class="footer__col">
        <h2 class="footer__col-title">
          <span lang="en-CA">{FOOTER_COL_HEADERS.basedIn.en}</span>
          <span class="footer__dot" aria-hidden="true">·</span>
          <span lang="zh-Hant">{FOOTER_COL_HEADERS.basedIn.zh}</span>
        </h2>
        <p class="footer__location">
          <span lang="en-CA">{FOOTER_LOCATION.en}</span>
          <span class="footer__location-zh" lang="zh-Hant">{FOOTER_LOCATION.zh}</span>
        </p>
      </div>
    )}
  </div>

  <div class="footer__bottom container">
    <p class="footer__copy">© {year} Human Education Collective Ltd.</p>
    <p class="footer__tagline">
      <span lang="en-CA">{FOOTER_TAGLINE_BOTTOM.en}</span>
      {bilingual && (
        <>
          <span class="footer__dot" aria-hidden="true">·</span>
          <span lang="zh-Hant">{FOOTER_TAGLINE_BOTTOM.zh}</span>
        </>
      )}
    </p>
  </div>
</footer>

<style>
.footer {
  background: var(--bg-warm);
  border-top: 1px solid var(--border-default);
  color: var(--text-primary);
  margin-top: 0;
}

.footer__inner {
  display: grid;
  gap: var(--space-10);
  padding-block: var(--space-16) var(--space-10);
  grid-template-columns: 1fr;
}
.footer--bilingual .footer__inner {
  grid-template-columns: 1fr;
}
@media (min-width: 48rem) {
  .footer--bilingual .footer__inner {
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }
  .footer--mono .footer__inner {
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }
}

.footer__brand {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  max-width: 32ch;
}
.footer__brand-zh {
  font-family: 'Noto Serif TC', 'Literata', ui-serif, serif;
  font-size: var(--fs-body);
  color: var(--text-secondary);
}
.footer__brand-en {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}

.footer__col-title {
  font-family: var(--font-body);
  font-size: var(--fs-small);
  font-weight: var(--fw-body-bold);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
  color: var(--text-secondary);
  display: inline-flex;
  align-items: baseline;
  gap: var(--space-1);
  margin-bottom: var(--space-4);
}
.footer__col-title [lang='zh-Hant'] {
  text-transform: none;
  letter-spacing: 0.02em;
}

.footer__dot {
  color: var(--color-terracotta);
  font-weight: var(--fw-body-bold);
}

.footer__links {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  list-style: none;
  padding: 0;
  margin: 0;
}
.footer__link {
  color: var(--text-primary);
  text-decoration: none;
  font-size: var(--fs-body);
  display: inline-flex;
  align-items: baseline;
  gap: var(--space-1);
}
.footer__link:hover {
  color: var(--text-brand);
  text-decoration: underline;
}
.footer__link [lang='zh-Hant'] {
  font-family: var(--font-body);
}

.footer__location {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  font-size: var(--fs-body);
}
.footer__location-zh {
  color: var(--text-secondary);
}

.footer__bottom {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-block: var(--space-4) var(--space-8);
  border-top: 1px solid var(--border-default);
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}
@media (min-width: 48rem) {
  .footer__bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
  }
}
.footer__tagline {
  display: inline-flex;
  gap: var(--space-1);
  align-items: baseline;
}
</style>
