---
/**
 * BilingualBlock — a two-column block that sits EN side-by-side with ZH.
 *
 * On narrow viewports the columns stack with EN first (default) and ZH
 * below. `order="zh-first"` flips the order on wide viewports.
 *
 * Content is passed via slots:
 *   <BilingualBlock>
 *     <div slot="en">...English...</div>
 *     <div slot="zh">...中文...</div>
 *   </BilingualBlock>
 *
 * The block sets `lang` attributes on each column so screen readers pick
 * the right pronunciation.
 */
interface Props {
  /** Visual order on wide viewports. */
  order?: 'en-first' | 'zh-first';
  /** Optional class passthrough. */
  class?: string;
}
const { order = 'en-first', class: className } = Astro.props;
---
<div class:list={['bilingual', order, className]}>
  <div class="bilingual__col bilingual__col--en" lang="en-CA">
    <slot name="en" />
  </div>
  <div class="bilingual__col bilingual__col--zh" lang="zh-Hant">
    <slot name="zh" />
  </div>
</div>

<style>
.bilingual {
  display: grid;
  gap: var(--space-8);
  grid-template-columns: 1fr;
}

.bilingual__col {
  min-width: 0;
}

.bilingual__col > * + * {
  margin-top: var(--space-3);
}

@media (min-width: 48rem) {
  .bilingual {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
  }
  .bilingual.zh-first .bilingual__col--zh { order: 1; }
  .bilingual.zh-first .bilingual__col--en { order: 2; }
}

.bilingual__col--zh {
  color: var(--text-secondary);
}

@media (min-width: 48rem) {
  .bilingual__col--zh {
    color: var(--text-primary);
  }
}
</style>
