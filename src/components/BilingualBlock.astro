---
/**
 * BilingualBlock — EN and ZH text, side by side.
 *
 * Used for the "Learning is the point" section on the homepage. EN on
 * the left, ZH on the right; on mobile they stack with ZH below. Each
 * side takes a title and a body.
 *
 * The eyebrow is shared across both languages (e.g. "WHAT WE BELIEVE ·
 * 我們的信念") and rendered once above.
 */
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrowEn?: string;
  eyebrowZh?: string;
  en: { title: string; body: string };
  zh: { title: string; body: string };
}
const { eyebrowEn, eyebrowZh, en, zh } = Astro.props;
---
<section class="bb section">
  <div class="bb__inner container">
    {(eyebrowEn || eyebrowZh) && (
      <Eyebrow en={eyebrowEn} zh={eyebrowZh} />
    )}
    <div class="bb__grid">
      <div class="bb__col" lang="en-CA">
        <h2 class="bb__title">{en.title}</h2>
        <p class="bb__body">{en.body}</p>
      </div>
      <div class="bb__col bb__col--zh" lang="zh-Hant">
        <h2 class="bb__title bb__title--zh">{zh.title}</h2>
        <p class="bb__body bb__body--zh">{zh.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
.bb { background: var(--bg-warm); }
.bb__inner { display: flex; flex-direction: column; gap: var(--space-10); }

.bb__grid {
  display: grid;
  gap: var(--space-10);
  grid-template-columns: 1fr;
}
@media (min-width: 64rem) {
  .bb__grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-24);
    align-items: start;
  }
}

.bb__col { display: flex; flex-direction: column; gap: var(--space-4); }

.bb__title {
  font-family: var(--font-display);
  font-size: var(--fs-h1);
  line-height: var(--lh-h1);
  letter-spacing: var(--ls-h1);
  font-weight: var(--fw-h1);
  max-width: 20ch;
}
.bb__title--zh {
  font-family: 'Noto Serif TC', 'Literata', ui-serif, serif;
}
.bb__body {
  font-size: var(--fs-body-lg);
  line-height: var(--lh-body-lg);
  color: var(--text-primary);
  max-width: 48ch;
}
.bb__body--zh {
  font-family: var(--font-body);
  line-height: 1.75;
}
</style>
