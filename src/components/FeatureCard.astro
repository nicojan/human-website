---
/**
 * FeatureCard — numbered service card for the Services page grid.
 *
 * A numbered terracotta badge, a title, a body paragraph, and a single
 * "Good for:" line that summarises the fit. Cards sit on the warm
 * background and use the canvas surface for the card itself.
 */
interface Props {
  /** 1-indexed badge number. Rendered as "01" etc. */
  number: number;
  title: string;
  body: string;
  goodFor: string;
}

const { number, title, body, goodFor } = Astro.props;
const badgeLabel = String(number).padStart(2, '0');
---
<article class="feature-card">
  <span class="feature-card__badge" aria-hidden="true">{badgeLabel}</span>
  <div class="feature-card__body">
    <h3 class="feature-card__title">{title}</h3>
    <p class="feature-card__copy">{body}</p>
    <p class="feature-card__good-for">
      <span class="feature-card__good-for-label">Good for:</span>
      <span class="feature-card__good-for-text">{goodFor}</span>
    </p>
  </div>
</article>

<style>
.feature-card {
  background: var(--bg-canvas);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  height: 100%;
}

.feature-card__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  background: var(--color-terracotta);
  color: var(--color-white);
  font-family: var(--font-display);
  font-size: var(--fs-body);
  font-weight: var(--fw-body-bold);
  letter-spacing: 0;
}

.feature-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  flex: 1;
}

.feature-card__title {
  font-family: var(--font-display);
  font-size: var(--fs-h3);
  line-height: var(--lh-h3);
  letter-spacing: var(--ls-h3);
  font-weight: var(--fw-h3);
  color: var(--text-primary);
}

.feature-card__copy {
  color: var(--text-primary);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}

.feature-card__good-for {
  margin-top: auto;
  padding-top: var(--space-4);
  border-top: 1px solid var(--border-default);
  font-size: var(--fs-caption);
  line-height: var(--lh-caption);
  color: var(--text-secondary);
}
.feature-card__good-for-label {
  font-weight: var(--fw-body-bold);
  color: var(--text-primary);
  margin-right: var(--space-1);
}
</style>
