---
/**
 * FaqItem — a <details>/<summary> Q/A block.
 * Pure CSS + HTML; no JS needed. Keyboard-accessible by default.
 * Pass the rendered answer into the default slot (from Astro's content
 * collection Content component).
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'faq'>;
}
const { item } = Astro.props;
---
<details class="faq-item" id={item.data.pair_key}>
  <summary class="faq-item__summary">
    <span class="faq-item__question">{item.data.question}</span>
    <span class="faq-item__icon" aria-hidden="true">+</span>
  </summary>
  <div class="faq-item__answer">
    <slot />
  </div>
</details>

<style>
.faq-item {
  border-bottom: 1px solid var(--border-default);
}
.faq-item:first-child { border-top: 1px solid var(--border-default); }

.faq-item__summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding-block: var(--space-5);
  cursor: pointer;
  min-height: var(--touch-min);
}
.faq-item__summary::-webkit-details-marker { display: none; }
.faq-item__summary:hover .faq-item__question { color: var(--text-brand); }

.faq-item__question {
  font-family: var(--font-display);
  font-size: var(--fs-h4);
  font-weight: var(--fw-h4);
  line-height: var(--lh-h4);
  transition: color var(--duration-fast) var(--ease-out);
}

.faq-item__icon {
  font-size: var(--fs-h3);
  color: var(--text-brand);
  font-weight: var(--fw-body-bold);
  flex-shrink: 0;
  transition: transform var(--duration-normal) var(--ease-out);
}
.faq-item[open] .faq-item__icon { transform: rotate(45deg); }

.faq-item__answer {
  padding-block: 0 var(--space-5);
  max-width: 60ch;
  color: var(--text-primary);
}
.faq-item__answer :global(p + p) { margin-top: var(--space-3); }
</style>
