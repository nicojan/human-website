---
/**
 * FaqItem — a bilingual Q/A block. The disclosure summary shows the
 * English question and the Chinese question side by side; the answer
 * body renders both languages too.
 *
 * Slots:
 *   - "answer-en"
 *   - "answer-zh"
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  en?: CollectionEntry<'faq'>;
  zh?: CollectionEntry<'faq'>;
  pair_key: string;
}
const { en, zh, pair_key } = Astro.props;
---
<details class="faq-item" id={pair_key}>
  <summary class="faq-item__summary">
    <div class="faq-item__questions">
      {en && (
        <span class="faq-item__question" lang="en-CA">{en.data.question}</span>
      )}
      {zh && (
        <span class="faq-item__question faq-item__question--zh" lang="zh-Hant">{zh.data.question}</span>
      )}
    </div>
    <span class="faq-item__icon" aria-hidden="true">+</span>
  </summary>
  <div class="faq-item__answer">
    {en && (
      <div class="faq-item__answer-col" lang="en-CA">
        <slot name="answer-en" />
      </div>
    )}
    {zh && (
      <div class="faq-item__answer-col faq-item__answer-col--zh" lang="zh-Hant">
        <slot name="answer-zh" />
      </div>
    )}
  </div>
</details>

<style>
.faq-item {
  border-bottom: 1px solid var(--border-default);
}
.faq-item:first-child { border-top: 1px solid var(--border-default); }

.faq-item__summary {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--space-4);
  padding-block: var(--space-5);
  cursor: pointer;
  min-height: var(--touch-min);
}
.faq-item__summary::-webkit-details-marker { display: none; }
.faq-item__summary:hover .faq-item__question { color: var(--text-brand); }

.faq-item__questions {
  display: grid;
  gap: var(--space-1);
  grid-template-columns: 1fr;
}
@media (min-width: 48rem) {
  .faq-item__questions {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: baseline;
  }
}

.faq-item__question {
  font-family: var(--font-display);
  font-size: var(--fs-h4);
  font-weight: var(--fw-h4);
  line-height: var(--lh-h4);
  transition: color var(--duration-fast) var(--ease-out);
}
.faq-item__question--zh {
  font-family: 'Noto Serif TC', ui-serif, serif;
}

.faq-item__icon {
  font-size: var(--fs-h3);
  color: var(--text-brand);
  font-weight: var(--fw-body-bold);
  transition: transform var(--duration-normal) var(--ease-out);
}
.faq-item[open] .faq-item__icon { transform: rotate(45deg); }

.faq-item__answer {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  padding-block: 0 var(--space-6);
}
@media (min-width: 48rem) {
  .faq-item__answer {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }
}
.faq-item__answer-col :global(p + p) { margin-top: var(--space-3); }
.faq-item__answer-col--zh {
  font-family: var(--font-body);
  color: var(--text-secondary);
}
@media (min-width: 48rem) {
  .faq-item__answer-col--zh {
    color: var(--text-primary);
  }
}
</style>
