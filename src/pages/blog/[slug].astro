---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@layouts/BlogPostLayout.astro';
import { groupByPairKey } from '@utils/i18n';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const pairs = groupByPairKey(all);
  return pairs.map((pair) => ({
    params: { slug: pair.pair_key },
    props: { pair },
  }));
}

const { pair } = Astro.props;
const EnContent = pair.en ? (await render(pair.en)).Content : null;
const ZhContent = pair.zh ? (await render(pair.zh)).Content : null;
---
<BlogPostLayout en={pair.en} zh={pair.zh}>
  {EnContent && <EnContent slot="body-en" />}
  {ZhContent && <ZhContent slot="body-zh" />}
</BlogPostLayout>
