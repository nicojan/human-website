---
/**
 * Writing — blog index. Lists the English entries of the blog
 * collection, newest first. The bilingual pair machinery stays intact
 * under the hood so an entry's ZH body still renders on the post page,
 * but the index is mono EN to match the new nav structure.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogCard from '@components/BlogCard.astro';
import SectionHeader from '@components/SectionHeader.astro';

const allEn = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
allEn.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const hreflang = [
  { hreflang: 'en', href: 'https://forhuman.ca/writing' },
  { hreflang: 'x-default', href: 'https://forhuman.ca/writing' },
];
---
<BaseLayout
  title="Writing"
  description="Writing from Nico Jan on literature, learning, and what it means to stay human while learning."
  chrome="mono"
  htmlLang="en-CA"
  locale="en"
  mirrorHref="/writing"
  hreflang={hreflang}
>
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="WRITING"
        title="Notes from Nico Jan."
        sub="Short pieces on literature, on teaching, and on what it means to stay human while learning."
      />
      {allEn.length === 0 ? (
        <p class="empty">No posts yet. Check back soon.</p>
      ) : (
        <div class="writing-index__grid">
          {allEn.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
.writing-index__grid {
  display: grid;
  gap: var(--space-6);
  grid-template-columns: 1fr;
}
@media (min-width: 48rem) {
  .writing-index__grid { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
}
@media (min-width: 80rem) {
  .writing-index__grid { grid-template-columns: repeat(3, 1fr); }
}

.empty {
  font-size: var(--fs-body);
  color: var(--text-secondary);
  padding-block: var(--space-12);
}
</style>
