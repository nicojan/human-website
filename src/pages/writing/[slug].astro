---
/**
 * Writing post — dynamic route by pair_key. The bilingual pair machinery
 * stays here so an entry can have a ZH mirror rendered alongside, but
 * for v1 most posts ship EN only.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPostLayout from '@layouts/BlogPostLayout.astro';

type BlogPost = CollectionEntry<'blog'>;

interface Pair {
  pair_key: string;
  en?: BlogPost;
  zh?: BlogPost;
}

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const byKey = new Map<string, Pair>();
  for (const entry of all) {
    const existing: Pair = byKey.get(entry.data.pair_key) ?? { pair_key: entry.data.pair_key };
    if (entry.data.lang === 'en') existing.en = entry;
    else if (entry.data.lang === 'zh') existing.zh = entry;
    byKey.set(entry.data.pair_key, existing);
  }
  return [...byKey.values()].map((pair) => ({
    params: { slug: pair.pair_key },
    props: { pair },
  }));
}

const { pair } = Astro.props;
const EnContent = pair.en ? (await render(pair.en)).Content : null;
const ZhContent = pair.zh ? (await render(pair.zh)).Content : null;
---
<BlogPostLayout en={pair.en} zh={pair.zh}>
  {EnContent && <EnContent slot="body-en" />}
  {ZhContent && <ZhContent slot="body-zh" />}
</BlogPostLayout>
