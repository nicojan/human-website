---
/**
 * 404 — short, bilingual. Offers a route back to home and to the two
 * main inner pages. Keeps the mono chrome so the footer still works.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
---
<BaseLayout
  title="Page not found"
  description="That page doesn't exist on this site. Here are a few places to go next."
  chrome="mono"
  htmlLang="en-CA"
  locale="en"
  mirrorHref="/"
>
  <section class="section not-found">
    <div class="container narrow">
      <p class="not-found__eyebrow">
        <span lang="en-CA">404</span>
        <span class="not-found__dot" aria-hidden="true">·</span>
        <span lang="zh-Hant">頁面不存在</span>
      </p>
      <h1 class="not-found__title" lang="en-CA">
        That page isn't here.
      </h1>
      <p class="not-found__title-zh" lang="zh-Hant">
        找不到這個頁面。
      </p>
      <p class="not-found__body" lang="en-CA">
        The link might be stale, or the address may have a typo. Start from one of these instead.
      </p>

      <div class="not-found__actions">
        <Button href="/" variant="primary" size="md">Home</Button>
        <Button href="/services" variant="ghost" size="md">Services</Button>
        <Button href="/about" variant="ghost" size="md">About</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.not-found { padding-block: var(--space-20) var(--space-24); }
.narrow { max-width: 48rem; margin-inline: auto; }

.not-found__eyebrow {
  display: inline-flex;
  gap: var(--space-2);
  font-size: var(--fs-small);
  font-weight: var(--fw-body-bold);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
  color: var(--text-secondary);
  margin-bottom: var(--space-4);
}
.not-found__dot { color: var(--color-terracotta); }

.not-found__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  line-height: 1.1;
  letter-spacing: var(--ls-h1);
  font-weight: var(--fw-display);
  max-width: 18ch;
}

.not-found__title-zh {
  font-family: 'Noto Serif TC', 'Literata', ui-serif, serif;
  font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  color: var(--text-secondary);
  margin-top: var(--space-2);
}

.not-found__body {
  margin-top: var(--space-6);
  font-size: var(--fs-body-lg);
  line-height: var(--lh-body-lg);
  color: var(--text-primary);
  max-width: 48ch;
}

.not-found__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: var(--space-8);
}
</style>
