---
/**
 * Services (ZH) — v1 stub. Chinese copy for the services and FAQ is
 * deferred until it can be produced with a native editor.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';

const hreflang = [
  { hreflang: 'en', href: 'https://forhuman.ca/services' },
  { hreflang: 'zh-Hant', href: 'https://forhuman.ca/zh-hant/services' },
  { hreflang: 'x-default', href: 'https://forhuman.ca/services' },
];
---
<BaseLayout
  title="課程"
  description="課程方案即將推出完整中文版。目前英文版已上線。"
  chrome="mono"
  htmlLang="zh-Hant"
  locale="zh-hant"
  mirrorHref="/services"
  hreflang={hreflang}
>
  <Hero
    variant="mono"
    en={{
      headline: '即將推出',
      sub: 'Coming soon. Our full services page is available in English at /services.',
    }}
  />

  <section class="section section--narrow">
    <div class="container narrow">
      <p lang="zh-Hant" class="coming-soon-body">
        課程方案的完整中文介紹正在整理中。目前英文版已上線，點擊上方的「EN」即可閱讀詳細說明。謝謝您的耐心。
      </p>
      <p lang="en-CA" class="coming-soon-body">
        The full Chinese services page is in preparation. The English version is live — click "EN" above. Thank you for your patience.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
.section--narrow { padding-block: var(--space-16); }
.narrow { max-width: 48rem; margin-inline: auto; }
.coming-soon-body {
  font-size: var(--fs-body-lg);
  line-height: var(--lh-body-lg);
  color: var(--text-secondary);
  max-width: 54ch;
}
.coming-soon-body + .coming-soon-body {
  margin-top: var(--space-6);
}
</style>
