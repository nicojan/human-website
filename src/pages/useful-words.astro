---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import WordCard from '@components/WordCard.astro';
import { groupByPairKey } from '@utils/i18n';

const all = await getCollection('useful_words');
const pairs = groupByPairKey(all);

// Sort alphabetically by the English term (falls back to Chinese term).
pairs.sort((a, b) => {
  const aTerm = a.en?.data.term ?? a.zh?.data.term ?? '';
  const bTerm = b.en?.data.term ?? b.zh?.data.term ?? '';
  return aTerm.localeCompare(bTerm);
});

const rendered = await Promise.all(pairs.map(async (pair) => ({
  pair_key: pair.pair_key,
  en: pair.en,
  zh: pair.zh,
  EnContent: pair.en ? (await render(pair.en)).Content : null,
  ZhContent: pair.zh ? (await render(pair.zh)).Content : null,
})));
---
<BaseLayout
  title="Useful Words"
  description="A growing glossary of words, ideas, and habits of mind worth keeping — paired in English and Traditional Chinese."
>
  <section class="section">
    <div class="container prose">
      <p class="label">Useful Words · 字詞筆記</p>
      <div class="words-heading">
        <h1 lang="en-CA">Useful words.</h1>
        <h1 class="words-heading--zh" lang="zh-Hant">字詞筆記。</h1>
      </div>
      <div class="words-lede">
        <p lang="en-CA">
          A growing glossary of the words, ideas, and habits of mind worth
          keeping close. Added to over time, as they come up in class.
        </p>
        <p class="words-lede--zh" lang="zh-Hant">
          一本慢慢累積的小詞典，收錄課堂上出現、值得留在身邊的字、概念、與思考習慣。有一個寫一個。
        </p>
      </div>
      {rendered.length === 0 && (
        <p class="caption">No entries yet.</p>
      )}
      <div class="words-list">
        {rendered.map(({ pair_key, en, zh, EnContent, ZhContent }) => (
          <WordCard en={en} zh={zh} pair_key={pair_key}>
            {EnContent && <EnContent slot="body-en" />}
            {ZhContent && <ZhContent slot="body-zh" />}
          </WordCard>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.words-heading,
.words-lede {
  display: grid;
  gap: var(--space-2);
  grid-template-columns: 1fr;
  margin-bottom: var(--space-4);
}
.words-lede { margin-bottom: var(--space-10); }
@media (min-width: 48rem) {
  .words-heading,
  .words-lede {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: baseline;
  }
}
.words-heading h1 {
  font-family: var(--font-display);
  font-size: var(--fs-h1);
  line-height: var(--lh-h1);
  letter-spacing: var(--ls-h1);
  font-weight: var(--fw-h1);
}
.words-heading--zh {
  font-family: 'Noto Serif TC', ui-serif, serif;
}
.words-lede--zh {
  font-family: var(--font-body);
  color: var(--text-secondary);
}
@media (min-width: 48rem) {
  .words-lede--zh { color: var(--text-primary); }
}
.words-list { margin-top: var(--space-8); }
</style>
