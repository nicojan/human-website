---
/**
 * BaseLayout — root layout for every page.
 *
 * The document <html lang> reflects the primary language of the page.
 * Home uses en-CA (even though ZH co-exists on the page via inline lang
 * attributes). Mono inner pages use en-CA or zh-Hant to match the page
 * language.
 *
 * Nav / Footer variant is picked by prop:
 *   - chrome="bilingual" — Home only. Bilingual nav + footer.
 *   - chrome="mono"       — inner pages.
 *
 * mirrorHref is used by the LanguageToggle on mono pages; it's the URL
 * of the other-language version of the current page.
 */
import '@styles/tokens.css';
import '@styles/reset.css';
import '@styles/global.css';

import Nav from '@components/Nav.astro';
import SiteFooter from '@components/SiteFooter.astro';
import { SITE_DESCRIPTION, A11Y } from '@i18n/strings';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  mainClass?: string;
  ogImage?: string;
  /** Chrome variant. Defaults to "mono" for inner pages. */
  chrome?: 'bilingual' | 'mono';
  /** Document language. */
  htmlLang?: 'en-CA' | 'zh-Hant';
  /** Locale used by the language toggle on mono pages. */
  locale?: 'en' | 'zh-hant';
  /** Href of the mirror page for the toggle. */
  mirrorHref?: string;
  /** Additional <link rel="alternate"> entries for hreflang. */
  hreflang?: Array<{ hreflang: string; href: string }>;
}

const {
  title,
  description,
  canonical,
  mainClass,
  ogImage,
  chrome = 'mono',
  htmlLang = 'en-CA',
  locale = 'en',
  mirrorHref = '/',
  hreflang,
} = Astro.props;

const pageTitle = title === 'Human,' ? title : `${title} — Human,`;
const pageDesc = description ?? SITE_DESCRIPTION.en;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://forhuman.ca').toString();
const ogImg = new URL(ogImage ?? '/brand/human-og-1200x630.png', Astro.site ?? 'https://forhuman.ca').toString();

const skipLabel = htmlLang === 'zh-Hant' ? A11Y.skipToContent.zh : A11Y.skipToContent.en;
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#FAF7F2" media="(prefers-color-scheme: light)" />
  <meta name="color-scheme" content="light" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalUrl} />

  {hreflang?.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}

  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon-180x180.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Human," />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:locale" content={htmlLang === 'zh-Hant' ? 'zh_Hant' : 'en_CA'} />
  <meta property="og:locale:alternate" content={htmlLang === 'zh-Hant' ? 'en_CA' : 'zh_Hant'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImg} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* Preload fires the CSS fetch in parallel with the HTML parse, so
    * the font faces start downloading earlier and CLS drops. The
    * stylesheet link below is what actually applies the fonts. */}
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400..700;1,400..700&family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@400;600;700&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400..700;1,400..700&family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@400;600;700&display=swap"
  />

  <slot name="head" />
</head>
<body>
  <div class="page">
    <a href="#main" class="skip-link">{skipLabel}</a>
    <Nav
      variant={chrome}
      currentPath={Astro.url.pathname}
      currentLocale={locale}
      mirrorHref={mirrorHref}
    />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <SiteFooter variant={chrome} />
  </div>
</body>
</html>
